---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE } from '../../config';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout title={t('cv.title')} lang={lang}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-gray-200 dark:border-slate-800">
    <div>
      <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
        {t('cv.title')}
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
        {t('cv.subtitle')}
      </p>
    </div>

    <a
      href="/cv.pdf"
      target="_blank"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all self-start sm:self-auto"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      <span>{t('cv.download_button')}</span>
    </a>
  </div>

  <div class="space-y-12">
    <!-- Experiencia Laboral -->
    <section>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        {t('cv.experience')}
      </h3>

      <div class="relative border-l-2 border-gray-200 dark:border-slate-800 ml-3 space-y-8">
        <!-- Item 1 -->
        <div class="ml-6 relative">
          <span class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-blue-600 ring-4 ring-white dark:ring-slate-900"></span>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
            <h4 class="text-base font-bold text-gray-900 dark:text-white">
              Senior Software Engineer
            </h4>
            <span class="text-xs font-medium text-gray-500">2023 — Presente</span>
          </div>
          <p class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-2">Tech Solutions Inc. • Remoto</p>
          <ul class="list-disc list-outside ml-4 text-sm text-gray-600 dark:text-gray-300 space-y-1">
            <li>Liderazgo en el diseño y arquitectura de microservicios y plataformas web de alto tráfico.</li>
            <li>Optimización del rendimiento de aplicaciones reduciendo los tiempos de carga en un 40%.</li>
            <li>Implementación de prácticas DevOps y pipelines automatizados de CI/CD.</li>
          </ul>
        </div>

        <!-- Item 2 -->
        <div class="ml-6 relative">
          <span class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-gray-400 dark:bg-gray-600 ring-4 ring-white dark:ring-slate-900"></span>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
            <h4 class="text-base font-bold text-gray-900 dark:text-white">
              Software Developer
            </h4>
            <span class="text-xs font-medium text-gray-500">2020 — 2023</span>
          </div>
          <p class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-2">Digital Innovation Studio</p>
          <ul class="list-disc list-outside ml-4 text-sm text-gray-600 dark:text-gray-300 space-y-1">
            <li>Desarrollo de interfaces interactivas y APIs seguras para clientes internacionales.</li>
            <li>Modelado de bases de datos relacionales y no relacionales escalables.</li>
            <li>Colaboración activa en metodologías ágiles (Scrum/Kanban) y revisiones de código.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Educación -->
    <section>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
          <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
        </svg>
        {t('cv.education')}
      </h3>

      <div class="relative border-l-2 border-gray-200 dark:border-slate-800 ml-3 space-y-6">
        <div class="ml-6 relative">
          <span class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-blue-600 ring-4 ring-white dark:ring-slate-900"></span>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
            <h4 class="text-base font-bold text-gray-900 dark:text-white">
              Licenciatura / Ingeniería en Sistemas Computacionales o Informática
            </h4>
            <span class="text-xs font-medium text-gray-500">Graduado</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400">Universidad • Especialidad en Desarrollo de Software</p>
        </div>
      </div>
    </section>

    <!-- Habilidades Técnicas -->
    <section>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
        </svg>
        {t('cv.skills')}
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-gray-200 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-900/30">
          <h4 class="text-sm font-bold text-gray-900 dark:text-white mb-2">Lenguajes de Programación</h4>
          <p class="text-xs text-gray-600 dark:text-gray-400">JavaScript, TypeScript, Python, SQL, HTML5/CSS3</p>
        </div>

        <div class="p-4 rounded-xl border border-gray-200 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-900/30">
          <h4 class="text-sm font-bold text-gray-900 dark:text-white mb-2">Frameworks & Librerías</h4>
          <p class="text-xs text-gray-600 dark:text-gray-400">Astro, React, Node.js, Express, Tailwind CSS</p>
        </div>

        <div class="p-4 rounded-xl border border-gray-200 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-900/30">
          <h4 class="text-sm font-bold text-gray-900 dark:text-white mb-2">Bases de Datos</h4>
          <p class="text-xs text-gray-600 dark:text-gray-400">PostgreSQL, MySQL, SQLite, Redis, MongoDB</p>
        </div>

        <div class="p-4 rounded-xl border border-gray-200 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-900/30">
          <h4 class="text-sm font-bold text-gray-900 dark:text-white mb-2">Herramientas & DevOps</h4>
          <p class="text-xs text-gray-600 dark:text-gray-400">Git, GitHub Actions, Docker, Linux, CI/CD</p>
        </div>
      </div>
    </section>

    <!-- Idiomas -->
    <section>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
        {t('cv.languages')}
      </h3>
      <div class="flex flex-wrap gap-4 text-sm">
        <div class="flex items-center gap-2">
          <span class="font-bold text-gray-900 dark:text-white">Español:</span>
          <span class="text-gray-600 dark:text-gray-400">Nativo</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-gray-900 dark:text-white">Inglés:</span>
          <span class="text-gray-600 dark:text-gray-400">Profesional / Avanzado (B2/C1)</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
