---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import { useTranslations } from '../../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
const posts = (await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={t('blog.title')} lang={lang}>
  <div class="mb-8">
    <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
      {t('blog.title')}
    </h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
      {t('blog.subtitle')}
    </p>
  </div>

  <div class="space-y-6">
    {posts.length === 0 ? (
      <p class="text-gray-500">No blog posts available at the moment.</p>
    ) : (
      posts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        return (
          <article class="p-6 rounded-2xl border border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 hover:border-blue-500/50 transition-all hover:shadow-sm">
            <div class="flex items-center gap-3 text-xs text-gray-500 mb-2">
              <FormattedDate date={post.data.pubDate} lang={lang} />
              <span>•</span>
              <div class="flex gap-1.5">
                {post.data.tags.map((tag) => (
                  <span class="text-blue-600 dark:text-blue-400 font-medium">#{tag}</span>
                ))}
              </div>
            </div>

            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 hover:text-blue-600 dark:hover:text-blue-400">
              <a href={`/en/blog/${slug}`}>{post.data.title}</a>
            </h3>

            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4 leading-relaxed">
              {post.data.description}
            </p>

            <a
              href={`/en/blog/${slug}`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline"
            >
              <span>{t('blog.read_more')}</span>
              <span>→</span>
            </a>
          </article>
        );
      })
    )}
  </div>
</BaseLayout>
