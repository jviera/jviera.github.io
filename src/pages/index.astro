---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const lang = 'es';
const posts = (await getCollection('blog', ({ data }) => data.lang === 'es' && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const featuredProjects = (await getCollection('projects', ({ data }) => data.lang === 'es' && data.featured))
  .slice(0, 2);
---

<BaseLayout title="Inicio" lang={lang}>
  <!-- Hero / Introduction -->
  <section class="space-y-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900/40">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      Disponible para nuevos proyectos y colaboraciones
    </div>

    <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight">
      Hola, soy <span class="text-blue-600 dark:text-blue-400">{SITE.author}</span> 👋
    </h2>

    <div class="prose dark:prose-invert text-gray-600 dark:text-gray-300 text-base sm:text-lg leading-relaxed">
      <p>
        Soy <strong>{SITE.role[lang]}</strong>. Me apasiona resolver problemas complejos mediante software elegante, mantenible y de alto rendimiento. Mi enfoque combina la excelencia en ingeniería con un diseño centrado en el usuario.
      </p>
      <p>
        Este espacio digital funciona como mi carta de presentación al mundo: aquí documento mis conocimientos técnicos, publico mis pensamientos en formato de blog y expongo proyectos de código abierto y profesionales.
      </p>
    </div>
  </section>

  <!-- Áreas de especialidad / Conocimientos -->
  <section class="mt-12 pt-8 border-t border-gray-200 dark:border-slate-800">
    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
      </svg>
      Áreas de Especialidad & Conocimientos
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-5 rounded-xl border border-gray-200 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-900/50">
        <div class="text-2xl mb-2">⚡</div>
        <h4 class="font-bold text-gray-900 dark:text-white mb-1">Desarrollo Web & Frontend</h4>
        <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
          Arquitectura moderna, interfaces responsivas, accesibilidad y optimización web con Astro, React, Tailwind CSS y TypeScript.
        </p>
      </div>

      <div class="p-5 rounded-xl border border-gray-200 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-900/50">
        <div class="text-2xl mb-2">⚙️</div>
        <h4 class="font-bold text-gray-900 dark:text-white mb-1">Arquitectura & Backend</h4>
        <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
          Diseño de APIs RESTful, servicios escalables, patrones de diseño limpios y modelado de bases de datos relacionales y no relacionales.
        </p>
      </div>

      <div class="p-5 rounded-xl border border-gray-200 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-900/50">
        <div class="text-2xl mb-2">🚀</div>
        <h4 class="font-bold text-gray-900 dark:text-white mb-1">DevOps & Buenas Prácticas</h4>
        <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
          Integración continua (CI/CD) con GitHub Actions, despliegue estático, testing automatizado y control de versiones con Git.
        </p>
      </div>
    </div>
  </section>

  <!-- Proyectos Destacados -->
  {featuredProjects.length > 0 && (
    <section class="mt-12 pt-8 border-t border-gray-200 dark:border-slate-800">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
          Proyectos Destacados
        </h3>
        <a href="/projects" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
          Ver todos los proyectos →
        </a>
      </div>

      <div class="grid grid-cols-1 gap-4">
        {featuredProjects.map((project) => (
          <div class="p-5 rounded-xl border border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900/30 hover:border-blue-500/50 transition-colors">
            <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-1">
              {project.data.title}
            </h4>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
              {project.data.description}
            </p>
            <div class="flex flex-wrap items-center gap-2">
              {project.data.tags.map((tag) => (
                <span class="text-xs px-2.5 py-0.5 rounded-full bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300">
                  {tag}
                </span>
              ))}
              {project.data.link && (
                <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="ml-auto text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline">
                  Ver proyecto ↗
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Últimas Publicaciones del Blog -->
  {posts.length > 0 && (
    <section class="mt-12 pt-8 border-t border-gray-200 dark:border-slate-800">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
          </svg>
          Últimos Pensamientos & Publicaciones
        </h3>
        <a href="/blog" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
          Ver todo el blog →
        </a>
      </div>

      <div class="space-y-4">
        {posts.map((post) => {
          const slug = post.id.replace(/\.(md|mdx)$/, '');
          return (
            <article class="p-5 rounded-xl border border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900/30 hover:border-blue-500/50 transition-colors">
              <div class="text-xs text-gray-500 mb-2">
                <FormattedDate date={post.data.pubDate} lang={lang} />
              </div>
              <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-1 hover:text-blue-600 dark:hover:text-blue-400">
                <a href={`/blog/${slug}`}>{post.data.title}</a>
              </h4>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                {post.data.description}
              </p>
              <a href={`/blog/${slug}`} class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
                Leer artículo completo →
              </a>
            </article>
          );
        })}
      </div>
    </section>
  )}
</BaseLayout>
