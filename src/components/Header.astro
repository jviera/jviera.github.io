---
import { useTranslations } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === 'es' ? '' : '/en';

const navItems = [
  { href: `${basePath}/`, label: t('nav.about') },
  { href: `${basePath}/blog`, label: t('nav.blog') },
  { href: `${basePath}/projects`, label: t('nav.projects') },
  { href: `${basePath}/cv`, label: t('nav.cv') },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-gray-200 dark:border-slate-800 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href={`${basePath}/`} class="text-xl font-bold tracking-tight text-gray-900 dark:text-white flex items-center gap-2 group">
      <span class="w-2.5 h-2.5 rounded-full bg-blue-600 group-hover:scale-125 transition-transform"></span>
      <span>jviera<span class="text-blue-600 dark:text-blue-400">.dev</span></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-1">
      {navItems.map((item) => {
        const isActive =
          item.href === `${basePath}/`
            ? currentPath === '/' || currentPath === '/en' || currentPath === '/en/'
            : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
              isActive
                ? 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold'
                : 'text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-slate-800'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Controls (Lang + Theme + Mobile toggle) -->
    <div class="flex items-center space-x-3">
      <LanguagePicker currentLang={lang} />
      <ThemeToggle lang={lang} />

      <!-- Mobile menu hamburger button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-slate-800"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-slate-800"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
